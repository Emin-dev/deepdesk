  "findings": [
    {
      "id": "client_selection",
      "finding": "Starlette first imports httpx2 as httpx and falls back to httpx only on ModuleNotFoundError. Both distributions are in the reviewed full runtime; expect httpx2 2.13.1. Record starlette.testclient.httpx.__name__ and its distribution version. Do not force a different module or claim this lane tests httpx 0.28.1.",
      "evidence": [
        "starlette_client_selection",
        "httpx2_client",
        "httpx_client"
      ]
    },
    {
      "id": "compatible_constructor",
      "finding": "Pinned TestClient accepts base_url, follow_redirects, client, backend and raise_server_exceptions, and supplies its own _TestClientTransport to the selected HTTP client. FastAPI TestClient is the same class.",
      "evidence": [
        "starlette_constructor",
        "fastapi_testclient_alias"
      ]
    },
    {
      "id": "lifespan",
      "finding": "A with TestClient(...) context creates an AnyIO blocking portal and in-memory lifespan channels, calls startup before yielding the client, and waits for shutdown during context exit. Merely constructing TestClient does not do this. The upstream lifespan initializes its real loop, middleware state, queues/schedulers and DB shutdown; no lifespan stubs are required.",
      "evidence": [
        "starlette_lifespan",
        "upstream_lifespan"
      ]
    },
    {
      "id": "cookies",
      "finding": "Both pinned HTTP clients maintain a CookieJar, merge its cookies into later requests, and extract Set-Cookie before redirect handling returns. The real Starlette SessionMiddleware signs, verifies and expires session cookies. Use the same TestClient within each phase and a fresh client in the next interpreter; do not substitute hand-made session cookies. HTTP cookie behavior is covered, but browser SameSite enforcement is not.",
      "evidence": [
        "httpx_client",
        "httpx_cookies_host",
        "httpx2_client",
        "httpx2_cookies_host",
        "starlette_session"
      ]
    },
    {
      "id": "redirects",
      "finding": "follow_redirects=False returns the original response, status and Location; next_request may be prepared but is not sent. Do not send response.next_request or override follow_redirects on individual requests. Assert empty response.history and expected Location in login/register/logout checks.",
      "evidence": [
        "httpx_client",
        "httpx2_client",
        "starlette_constructor"
      ]
    },
    {
      "id": "scope",
      "finding": "For http://127.0.0.1:54321 and client=(127.0.0.1,54322), HTTP scope has scheme=http, http_version=1.1, server=[127.0.0.1,54321], client=(127.0.0.1,54322), root_path empty and the real request method/path/query. Host is generated from URL unless explicitly supplied, then retained as supplied. The wrapper therefore sees exactly Host: 127.0.0.1:54321; these ports are synthetic scope values, not reserved or bound ports.",
      "evidence": [
        "starlette_scope",
        "httpx_cookies_host",
        "httpx2_cookies_host",
        "managed_wrapper"
      ]
    },
    {
      "id": "no_tcp_http_transport",
      "finding": "The TestClient request path collects bodies in BytesIO and invokes self.app(scope, receive, send) via portal.call. Both HTTP clients return the supplied transport instead of creating HTTPTransport; environment proxies are disabled when a custom transport is present. Intercepting uvicorn.run avoids Uvicorn server.run/binding. This proves the selected HTTP transport has no TCP bind/connect path; it does not prove the application and dependencies cannot attempt unrelated sockets. Preserve the OS deny(network*) guard.",
      "evidence": [
        "starlette_inprocess_call",
        "starlette_constructor",
        "httpx_client",
        "httpx2_client",
        "uvicorn_run"
      ]
    },
    {
      "id": "internal_socketpair",
      "finding": "AnyIO default backend is asyncio with use_uvloop false. Its portal creates a thread and asyncio Runner; CPython Unix event-loop construction calls _make_self_pipe and socket.socketpair(), whose native default is AF_UNIX. Thus a blanket monkeypatch denying every socket constructor can break the fixture itself. macOS sandbox acceptance of this exact internal operation is unverified here; keep deny(network*) unchanged and fail closed if portal startup is denied. Do not add network exceptions to make the test pass.",
      "evidence": [
        "starlette_constructor",
        "anyio_portal",
        "anyio_asyncio_runner",
        "cpython_runner",
        "cpython_unix_policy",
        "cpython_self_pipe",
        "cpython_socketpair"
      ]
    },
    {
      "id": "boundedness",
      "finding": "TestClient waits synchronously on portal.call and buffers the complete response in BytesIO before returning. HTTP timeout arguments and a post-response byte-length assertion do not impose an application execution deadline or prevent response buffering. Retain an external bounded subprocess deadline, output cap and existing resource controls.",
      "evidence": [
        "starlette_inprocess_call",
        "httpx_client",
        "httpx2_client"
      ]
    },
    {
      "id": "coverage_boundary",
      "finding": "This lane can validate real middleware/auth/CSRF/session/report/DB behavior and normal ASGI lifespan completion in two fresh interpreters. It does not validate an actual HTTP listener, Uvicorn HTTP parser, sockets, signal handling, graceful-shutdown timeout, uvloop selection, app packaging/frozen launcher, browser security semantics, model inference, providers or external research.",
      "evidence": [
        "starlette_scope",
        "starlette_lifespan",
        "managed_wrapper",
        "upstream_launcher",
        "uvicorn_run"
      ]
    }
  ],
  "recommended_call_contract": {
    "interception_order": [
      "Load only uvicorn before patching uvicorn.run; do not import local_deep_research first.",
      "Load the existing engine_entry.py without invoking its __main__ branch; call its unchanged serve().",
      "Require the intercepted run call to occur exactly once and match the exact positional/keyword arguments below.",
      "Only inside the interceptor, resolve local_deep_research.web.fastapi_app:app and verify it is the cached module-level app that serve() already configured.",
      "Run the real scenario inside with TestClient(app, base_url=..., follow_redirects=False, client=..., backend=\"asyncio\", raise_server_exceptions=True).",
      "Let the context complete normally and propagate startup/request/shutdown errors; restore uvicorn.run in finally.",
      "Run each phase in its own fresh interpreter while preserving only the isolated synthetic data directory needed for persistence checks."
    ],
    "uvicorn_positional_args": [
      "local_deep_research.web.fastapi_app:app"
    ],
    "uvicorn_keyword_args": {
      "host": "127.0.0.1",
      "port": 54321,
      "workers": 1,
      "log_level": "warning",
      "access_log": false,
      "server_header": false,
      "timeout_keep_alive": 5,
      "timeout_graceful_shutdown": 10,
      "proxy_headers": false,
      "forwarded_allow_ips": null
    },
    "testclient_arguments": {
      "base_url": "http://127.0.0.1:54321",
      "follow_redirects": false,
      "client": [
        "127.0.0.1",
        54322
      ],
      "backend": "asyncio",
      "raise_server_exceptions": true
    },
    "scope_expectations": {
      "type": "http",
      "http_version": "1.1",
      "scheme": "http",
      "root_path": "",
      "server": [
        "127.0.0.1",
        54321
      ],
      "client": [
        "127.0.0.1",
        54322
      ],
      "host_header": "127.0.0.1:54321"
    },
    "request_safety": [
      "Allow only known fixture-relative paths; reject absolute/network-path URLs.",
      "Send no Origin or Sec-Fetch-Site headers on accepted native requests; send the nonce header after the handshake.",
      "Use the actual selected HTTP client cookie jar; do not seed production cookies.",
      "For negative Host/Origin/nonce tests, expect wrapper-generated 403 without an instance header, because the wrapper returns before send_with_identity."
    ]
  },
