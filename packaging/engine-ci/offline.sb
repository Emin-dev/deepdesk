(version 1)
(allow default)
(deny network*)
(deny file-write*)
(allow file-write* (subpath (param "WORK_DIR")))
(allow file-write-data (literal "/dev/null"))
(deny file-write* (subpath (param "READONLY_PYTHON")))
(deny file-write* (subpath (param "READONLY_DOWNLOADS")))
(deny file-write* (subpath (param "READONLY_ENV")))
