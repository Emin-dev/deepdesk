(version 1)
(allow default)
(deny network*)
(deny file-write*)
(allow file-write* (subpath (param "WORK_DIR")))
(allow file-write-data (literal "/dev/null"))
(deny file-write* (subpath (param "IMMUTABLE_DIR")))
(deny file-write* (subpath (param "READONLY_ENV")))
; A hosted-runner Homebrew installation must not satisfy runtime dependencies.
(deny file-read* (subpath "/opt/homebrew"))
(deny file-read* (subpath "/usr/local"))
(deny file-read* (subpath "/Library/Frameworks/Python.framework"))
