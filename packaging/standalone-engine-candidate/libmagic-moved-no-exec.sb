(version 1)
(allow default)
(deny network*)
(deny file-write*)
(allow file-write* (subpath (param "WORK_DIR")))
(allow file-write-data (literal "/dev/null"))
(deny file-write* (subpath (param "IMMUTABLE_DIR")))
(deny file-write* (subpath (param "READONLY_ENV")))
(deny file-read* (subpath "/opt/homebrew"))
(deny file-read* (subpath "/usr/local"))
(deny file-read* (subpath "/opt/local"))
(deny file-read* (subpath "/Library/Frameworks/Python.framework"))
; Post-relocation only: no original interpreter, venv, source or staging fallback.
(deny file-read* (subpath (param "ORIGINAL_PYTHON")))
(deny file-read* (subpath (param "ORIGINAL_RUNTIME")))
(deny file-read* (subpath (param "BUILD_ENV")))
(deny file-read* (subpath (param "SOURCE_TREE")))
; Moved native fixture: exactly one profile, with inherited relocation denies.
(deny process-exec)
(allow process-exec (literal (param "FIXTURE_PATH")))
